# Configuración LOCAL del back. Copiala sin editar:
#   cp src/main/resources/env.properties.example src/main/resources/env.properties   (desde backend/coworkProject)
# Spring la importa desde el CLASSPATH (application.properties:1 -> optional:env.properties),
# por eso va en src/main/resources/ y no en la raíz del módulo. El archivo real está en .gitignore.
# Valores inventados, solo para local y coherentes con docker-compose.yml. Nunca pongas acá secretos reales.

# Host:puerto de PostgreSQL (docker compose expone 5432 en localhost)
DB_URL=localhost:5432
# Nombre de la base
DB_NAME=woodwork
# Usuario y contraseña de la base local (iguales a docker-compose.yml)
DB_USER=woodwork
DB_PASSWORD=woodwork
# Driver JDBC: sin esto el default es MySQL y falla contra Postgres
DB_DRIVER_CLASS_NAME=org.postgresql.Driver
# Dialecto de Hibernate (se concatena a org.hibernate.dialect.)
DB_DIALECT=PostgreSQLDialect

# Cloudinary (subida de imágenes). Con estos valores la app arranca, pero subir imágenes falla.
CLOUDINARY_NAME=local-demo
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=local-dummy-secret

# Secreto HMAC del JWT en base64 (>= 32 bytes). Generá otro con: openssl rand -base64 32
# Hoy el código NO la lee (usa un valor hardcodeado): se empieza a usar con T-001.
JWT_SECRET=af8yXPpZrn8JjphrYhtcaXmWFpvnlI2YrB90YBJUEKk=
